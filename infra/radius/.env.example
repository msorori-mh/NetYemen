WASEL_CONTROL_URL=https://YOUR_PROJECT.supabase.co/functions/v1/radius-control
WASEL_RADIUS_INTERNAL_KEY=REPLACE_WITH_32_BYTE_RANDOM_VALUE
WASEL_RADIUS_SHARED_SECRET=REPLACE_WITH_32_BYTE_RANDOM_VALUE
WASEL_NAS_NETWORK=REPLACE_WITH_ROUTER_PUBLIC_IP/32
# Optional. Immutable base image reference (digest) for non-local builds, e.g.
# freeradius/freeradius-server@sha256:<digest you resolved and verified>.
# WASEL_FREERADIUS_IMAGE=
# Optional. Host address the RADIUS ports are published on (default 0.0.0.0).
# Published Docker ports bypass ufw: see README "Network exposure".
# WASEL_RADIUS_BIND_IP=
