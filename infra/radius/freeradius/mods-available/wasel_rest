rest wasel_rest {
    connect_uri = "$ENV{WASEL_CONTROL_URL}"

    tls {
        check_cert = yes
        check_cert_cn = yes
    }

    authorize {
        uri = "${..connect_uri}"
        method = "post"
        body = "json"
        data = '{"action":"authorize","nas_identifier":"%{jsonquote:%{NAS-Identifier}}","client_shortname":"%{jsonquote:%{client:shortname}}","username":"%{jsonquote:%{User-Name}}","password":"%{jsonquote:%{User-Password}}","request_key":"%{jsonquote:%{Acct-Session-Id}}","device_fingerprint_hash":null}'
        tls = ${..tls}
    }

    # Numeric JSON fields default to 0: %{integer:X} expands to an empty
    # string when the NAS omits X (e.g. counters on Accounting-Start), which
    # would otherwise produce invalid JSON.
    accounting {
        uri = "${..connect_uri}"
        method = "post"
        body = "json"
        data = '{"action":"accounting","session_id":"%{jsonquote:%{string:&Class}}","nas_identifier":"%{jsonquote:%{NAS-Identifier}}","client_shortname":"%{jsonquote:%{client:shortname}}","event_key":"%{jsonquote:%{Acct-Session-Id}}:%{Acct-Status-Type}:%{Acct-Session-Time}:%{Acct-Input-Gigawords}:%{Acct-Input-Octets}:%{Acct-Output-Gigawords}:%{Acct-Output-Octets}","event_type":"%{tolower:%{Acct-Status-Type}}","event_at":"%S","input_bytes":%{%{integer:Acct-Input-Octets}:-0},"output_bytes":%{%{integer:Acct-Output-Octets}:-0},"input_gigawords":%{%{integer:Acct-Input-Gigawords}:-0},"output_gigawords":%{%{integer:Acct-Output-Gigawords}:-0},"session_seconds":%{%{integer:Acct-Session-Time}:-0}}'
        tls = ${..tls}
    }

    pool {
        start = 2
        min = 1
        max = 16
        spare = 2
        uses = 0
        lifetime = 0
        idle_timeout = 60
        retry_delay = 5
    }
}
