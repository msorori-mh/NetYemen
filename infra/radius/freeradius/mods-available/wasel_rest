rest wasel_rest {
    connect_uri = "$ENV{WASEL_CONTROL_URL}"

    tls {
        check_cert = yes
        check_cert_cn = yes
    }

    authorize {
        uri = "${..connect_uri}"
        method = "post"
        body = "json"
        data = '{"action":"authorize","nas_identifier":"%{jsonquote:%{NAS-Identifier}}","username":"%{jsonquote:%{User-Name}}","password":"%{jsonquote:%{User-Password}}","request_key":"%{jsonquote:%{Acct-Session-Id}}","device_fingerprint_hash":null}'
        header = "x-wasel-radius-key: $ENV{WASEL_RADIUS_INTERNAL_KEY}"
        tls = ${..tls}
    }

    accounting {
        uri = "${..connect_uri}"
        method = "post"
        body = "json"
        data = '{"action":"accounting","session_id":"%{jsonquote:%{Class}}","nas_identifier":"%{jsonquote:%{NAS-Identifier}}","event_key":"%{jsonquote:%{Acct-Session-Id}}:%{Acct-Status-Type}:%{Acct-Session-Time}:%{Acct-Input-Gigawords}:%{Acct-Input-Octets}:%{Acct-Output-Gigawords}:%{Acct-Output-Octets}","event_type":"%{tolower:%{Acct-Status-Type}}","event_at":"%{Event-Timestamp}","input_bytes":%{integer:Acct-Input-Octets},"output_bytes":%{integer:Acct-Output-Octets},"input_gigawords":%{integer:Acct-Input-Gigawords},"output_gigawords":%{integer:Acct-Output-Gigawords},"session_seconds":%{integer:Acct-Session-Time}}'
        header = "x-wasel-radius-key: $ENV{WASEL_RADIUS_INTERNAL_KEY}"
        tls = ${..tls}
    }

    pool {
        start = 2
        min = 1
        max = 16
        spare = 2
        uses = 0
        lifetime = 0
        idle_timeout = 60
        retry_delay = 5
    }
}
