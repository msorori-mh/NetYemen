server wasel {
    listen {
        type = auth
        ipaddr = *
        port = 1812
    }

    listen {
        type = acct
        ipaddr = *
        port = 1813
    }

    authorize {
        filter_username
        preprocess
        if (!&User-Name || !&User-Password || !&NAS-Identifier || !&Acct-Session-Id) {
            reject
        }
        update control {
            REST-HTTP-Header := "x-wasel-radius-key: $ENV{WASEL_RADIUS_INTERNAL_KEY}"
        }
        wasel_rest
        if (updated) {
            update control {
                Auth-Type := Accept
            }
        }
        else {
            reject
        }
    }

    authenticate {
        Auth-Type Accept {
            accept
        }
    }

    accounting {
        if (!&Class || !&NAS-Identifier || !&Acct-Session-Id || !&Acct-Status-Type) {
            reject
        }
        update control {
            REST-HTTP-Header := "x-wasel-radius-key: $ENV{WASEL_RADIUS_INTERNAL_KEY}"
        }
        wasel_rest
    }
}
