<?xml version="1.0" encoding="utf-8"?>
<!--
  The app stores the Supabase session and the PIN "trusted device" mark in
  shared preferences. Neither may leave the device through cloud backup or
  device-to-device transfer, or a restored copy on another phone would skip
  sign-in and the PIN gate (Android 12+; older versions use allowBackup).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
